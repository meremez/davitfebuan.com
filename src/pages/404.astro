---
import '../styles/global.css';
---
<html lang="en">
<head>
  <title>Page not found · Davit Febuan</title>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..600,0..100;1,9..144,300..600,0..100&family=IBM+Plex+Mono:wght@400;500&family=Karla:wght@400..700&display=swap" />
  <style>
    .nf { min-height: 100vh; display: grid; align-content: center; gap: 28px; }
    .nf h1 { font-size: clamp(4rem, 14vw, 11rem); line-height: 0.9; letter-spacing: -0.05em; font-variation-settings: 'opsz' 144; }
    .nf h1 em { color: var(--gold-2); }
    .nf p { color: var(--ink-2); max-width: 40ch; }
  </style>
</head>
<body>
  <main class="wrap nf">
    <span class="label">Error 404</span>
    <h1>Off the <em>route.</em></h1>
    <p>This page doesn’t exist. Halaman ini tidak ditemukan.</p>
    <p><a class="btn" href="/">Back to davitfebuan.com <span class="arrow" aria-hidden="true">→</span></a></p>
  </main>
</body>
</html>

---
import '../styles/global.css';
import { content, LINKEDIN, type Lang } from '../i18n/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
const target = process.env.DEPLOY_TARGET ?? 'production';
const site = Astro.site!.toString().replace(/\/$/, '');
const path = lang === 'en' ? '/' : '/id/';
const canonical = site + path;
const ogImage = `${site}/og-${lang}.png`;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: canonical,
  inLanguage: t.htmlLang,
  mainEntity: {
  '@type': 'Person',
  '@id': `${site}/#person`,
  name: 'Davit Febuan',
  url: site + '/',
  image: `${site}/davit-febuan.jpg`,
  description: t.meta.description,
  knowsLanguage: ['id', 'en'],
  jobTitle: 'E-Channel Services Head',
  worksFor: { '@type': 'Organization', name: 'Bank Mega' },
  address: { '@type': 'PostalAddress', addressLocality: 'Jakarta', addressCountry: 'ID' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Bina Nusantara University' },
  knowsAbout: ['ATM network operations', 'EDC operations', 'QRIS', 'Payment gateway', 'Vendor and SLA management', 'S&OP', 'Supply chain', 'Reverse logistics', 'Lean Six Sigma'],
  sameAs: [LINKEDIN],
  },
};
---
<html lang={t.htmlLang}>
<head>
  <title>{t.meta.title}</title>
  <meta charset="utf-8" />
  <script is:inline>
    (function () {
      var d = document.documentElement;
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        d.classList.add('js-motion');
        setTimeout(function () { d.classList.add('is-ready'); }, 3000);
      }
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="description" content={t.meta.description} />
  <meta name="deploy-target" content={target} />
  {target !== 'production' && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="en" href={site + '/'} />
  <link rel="alternate" hreflang="id" href={site + '/id/'} />
  <link rel="alternate" hreflang="x-default" href={site + '/'} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#f6f0e4" />

  <meta property="og:type" content="profile" />
  <meta property="og:site_name" content="Davit Febuan" />
  <meta property="og:title" content={t.meta.title} />
  <meta property="og:description" content={t.meta.description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Davit Febuan, Operations Leader" />
  <meta property="og:locale" content={t.locale} />
  <meta property="og:locale:alternate" content={lang === 'en' ? 'id_ID' : 'en_US'} />
  <meta property="profile:first_name" content="Davit" />
  <meta property="profile:last_name" content="Febuan" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={t.meta.title} />
  <meta name="twitter:description" content={t.meta.description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..600,0..100;1,9..144,300..600,0..100&family=IBM+Plex+Mono:wght@400;500&family=Karla:ital,wght@0,400..700;1,400&display=swap" />
  <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
</head>
<body>
  <a class="skip" href="#main">{t.a11y.skip}</a>
  <slot />
  <script>
    import '../scripts/main.ts';
  </script>
</body>
</html>

---
import type { Content } from '../i18n/content';
interface Props { t: Content }
const { t } = Astro.props;
const rows = [...t.certs, t.credentials.degree];
---
<section class="section credentials" id="credentials" aria-labelledby="cred-heading">
  <div class="wrap cred-grid">
    <h2 class="label" id="cred-heading">{t.credentials.label}</h2>
    <ul class="cred-list" data-fade>
      {rows.map((c) => <li><span class="name">{c.name}</span><span class="meta">{c.meta}</span></li>)}
    </ul>
  </div>
</section>

---
import { Image } from 'astro:assets';
import logo from '../assets/logo-df.png';
import type { Content, Lang } from '../i18n/content';
interface Props { t: Content; lang: Lang }
const { t, lang } = Astro.props;
const home = lang === 'en' ? '/' : '/id/';
const links = [
  ['story', t.nav.story], ['lifecycle', t.nav.lifecycle], ['journey', t.nav.journey], ['expertise', t.nav.expertise],
  ['impact', t.nav.impact], ['contact', t.nav.contact],
] as const;
---
<header class="nav" id="nav">
  <div class="wrap nav-inner">
    <a class="nav-mark" href={home + '#top'} data-scroll-to="#top" aria-label={t.a11y.home}>
      <Image src={logo} alt="" width={34} height={34} loading="eager" />
      <span translate="no">Davit Febuan</span>
    </a>
    <nav class="nav-links" aria-label={t.a11y.sections}>
      {links.map(([id, label]) => <a href={'#' + id} data-scroll-to={'#' + id} data-spy={id}>{label}</a>)}
    </nav>
    <div class="nav-tools">
      <div class="lang" role="group" aria-label={t.a11y.language}>
        {lang === 'en'
          ? <><span aria-current="true">EN</span><a href="/id/" hreflang="id" lang="id" data-lang-link aria-label="Bahasa Indonesia">ID</a></>
          : <><a href="/" hreflang="en" lang="en" data-lang-link aria-label="English">EN</a><span aria-current="true">ID</span></>}
      </div>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" data-menu-btn
        data-open={t.nav.menu} data-close={t.nav.close}>{t.nav.menu}</button>
    </div>
  </div>
  <div class="progress" data-progress aria-hidden="true"></div>
</header>
<div class="menu" id="menu" hidden data-menu>
  <ol>
    {links.map(([id, label]) => <li><a href={'#' + id} data-scroll-to={'#' + id}>{label}</a></li>)}
  </ol>
</div>

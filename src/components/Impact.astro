---
import type { Content, Lang } from '../i18n/content';
interface Props { t: Content; lang: Lang }
const { t, lang } = Astro.props;
const r = t.impact.receipt;
const now = t.impact.now;
// Current-role figures stay out of production until the owner confirms the bank allows publishing them.
const target = process.env.DEPLOY_TARGET ?? 'production';
const showNow = now.approved || target !== 'production';
const fmt = (s: (typeof t.impact.stats)[number]) => `${s.prefix ?? ''}${s.value}${s.suffix ?? ''}`;
const today = new Intl.DateTimeFormat(lang === 'en' ? 'en-GB' : 'id-ID', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'Asia/Jakarta' }).format(new Date());
---
<section class="section impact" id="impact" aria-labelledby="impact-heading">
  <div class="wrap impact-grid">
    <div class="impact-copy">
      <span class="label">{t.impact.label}</span>
      <h2 id="impact-heading" data-split>{t.impact.heading}</h2>
      <p data-fade>{showNow ? t.impact.note : t.impact.noteGated}</p>
      {showNow ? (
        <div class="impact-now" data-fade>
          <span class="label">{now.label}</span>
          <div class="impact-featured"><strong>{now.featured.value}</strong><span>{now.featured.label}</span></div>
          <div class="impact-list">
            {now.metrics.map((m) => <div><strong>{m.value}</strong><span>{m.label}</span></div>)}
          </div>
        </div>
      ) : (
        <div class="impact-list" data-fade>
          {t.impact.highlights.map((m) => <div><strong>{m.value}</strong><span>{m.label}</span></div>)}
        </div>
      )}
    </div>
    <div class="terminal" data-terminal>
      <div class="paper-clip">
        <div class="receipt" data-receipt role="group" aria-label={r.type}>
          <div class="c merchant" translate="no">{r.merchant}</div>
          <div class="c">{r.sub}</div>
          <hr class="rule" />
          <div class="row"><span>TXN</span><span>{r.type}</span></div>
          <div class="row"><span>{r.dateLabel}</span><span data-receipt-date>{today.toUpperCase()}</span></div>
          <hr class="rule" />
          {t.impact.stats.map((s) => (
            <div class="item" data-receipt-item>
              <b data-count={s.value} data-prefix={s.prefix ?? ''} data-suffix={s.suffix ?? ''}>{fmt(s)}</b>
              <span><em>{s.year}</em> · {s.label}</span>
            </div>
          ))}
          <hr class="rule" />
          <div class="c status">{r.status}</div>
          <div class="c"><span class="stamp">✓ {r.status.split(': ')[1]}</span></div>
          <div class="barcode" aria-hidden="true"></div>
          <div class="c">*** {r.thanks} ***</div>
        </div>
      </div>
      <div class="slot" aria-hidden="true"><span class="led"></span><span class="label">EDC · PRINT</span></div>
    </div>
  </div>
</section>

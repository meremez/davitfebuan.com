---
import { Image } from 'astro:assets';
import logo from '../assets/logo-df.png';
import type { Content } from '../i18n/content';
interface Props { t: Content }
const { t } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap">
    <div class="footer-top">
      <a class="footer-icon" href="#top" data-scroll-to="#top" aria-label="Davit Febuan, back to top">
        <Image src={logo} alt="" width={36} height={36} densities={[1, 2]} />
      </a>
      <a class="link-line" href="#top" data-scroll-to="#top">{t.footer.top} ↑</a>
    </div>
    <div class="wordmark" aria-hidden="true" data-wordmark>Davit <em>Febuan</em></div>
    <div class="footer-bottom">
      <span>© {year} Davit Febuan. {t.footer.rights}</span>
      <span>davitfebuan.com</span>
    </div>
  </div>
</footer>

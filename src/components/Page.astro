---
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Story from './Story.astro';
import Lifecycle from './Lifecycle.astro';
import Journey from './Journey.astro';
import Expertise from './Expertise.astro';
import Impact from './Impact.astro';
import Testimonials from './Testimonials.astro';
import Credentials from './Credentials.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import { content, type Lang } from '../i18n/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content[lang];
---
<Base lang={lang}>
  <Nav t={t} lang={lang} />
  <main id="main">
    <Hero t={t} />
    <Story t={t} />
    <Lifecycle t={t} />
    <Journey t={t} />
    <Expertise t={t} />
    <Impact t={t} lang={lang} />
    <Testimonials t={t} />
    <Credentials t={t} />
    <Contact t={t} />
  </main>
  <Footer t={t} />
</Base>

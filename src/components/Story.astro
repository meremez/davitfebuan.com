---
import type { Content } from '../i18n/content';
interface Props { t: Content }
const { t } = Astro.props;
const words = t.story.lead.split(' ');
---
<section class="section story" id="story" aria-labelledby="story-label">
  <div class="wrap story-grid">
    <div class="story-aside"><h2 class="label" id="story-label">{t.story.label}</h2></div>
    <div class="story-main">
      <p class="story-lead" data-scrub-words>
        {words.map((w, i) => <><span class="w">{w}</span>{i < words.length - 1 ? ' ' : ''}</>)}
      </p>
      <div class="story-body" data-fade>
        <p>{t.story.p2}</p>
        <p>{t.story.p3}</p>
      </div>
      <div class="chapters" data-fade>
        <article class="chapter">
          <span class="label">{t.story.chapters[0].tag}</span>
          <h3>{t.story.chapters[0].title}</h3>
          <p>{t.story.chapters[0].items}</p>
        </article>
        <div class="chapter-link" aria-hidden="true">
          <svg viewBox="0 0 48 14" fill="none"><path d="M0 7h45M39 1l6 6-6 6" stroke="currentColor" stroke-width="1.5" /></svg>
        </div>
        <article class="chapter">
          <span class="label">{t.story.chapters[1].tag}</span>
          <h3>{t.story.chapters[1].title}</h3>
          <p>{t.story.chapters[1].items}</p>
        </article>
      </div>
    </div>
  </div>
</section>
